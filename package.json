{
  "name": "dsh-better-todo",
  "version": "1.6.8",
  "description": "A floating todo panel for the DSH Web UI with a built-in pomodoro timer, today/more grouping and a separate all-items tab.",
  "type": "module",
  "license": "MIT",
  "author": "lewisyoung0914",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewisyoung0914/dsh-better-todo.git"
  },
  "homepage": "https://github.com/lewisyoung0914/dsh-better-todo#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "pomodoro"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "assets/screenshots/*.jpg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
